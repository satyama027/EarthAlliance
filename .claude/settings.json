{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/require-architecture-md.sh\"",
            "if": "Bash(git commit*)",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Checking ARCHITECTURE.md is staged…"
          }
        ]
      }
    ]
  }
}
